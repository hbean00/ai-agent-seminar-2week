# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Env
.env
.env.local

# oh-my-claudecode runtime state.
# Session files record work history and local absolute paths, which do not
# belong in a public repo. Project-scoped skills under .omc/skills/ are the
# one part meant to be committed.
.omc/
!.omc/skills/

# Project tag config (issue #16) -- contains personal project paths/hints,
# not meant for the public repo. See projects.example.toml.
projects.toml

# 개인 기능 폴더. 안에 .env(LMS 자격 증명)와 .browser_profile/(로그인 세션
# 쿠키)이 들어 있어 절대 공개 저장소로 나가면 안 된다. 기능 자체는
# capabilities/*.md 로 봇에 등록하되, 스크립트와 자격 증명은 추적하지 않는다.
_LMS 접근/

# 기능 레지스트리. 기능 파일에는 개인 PC의 절대경로와 운영 메모가 들어가므로
# projects.toml 과 같은 이유로 추적하지 않는다. capabilities.example/ 을
# capabilities/ 로 복사해 쓸 것.
capabilities/

# Discord 시절 .env 사본. 실제 봇 토큰이 들어 있다.
.env.discord-backup
